{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": null,
  "installCommand": "",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{frontend/**,backend/tests/**,tests/**,docs/**,scripts/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"}
      ]
    }
  ]
}
